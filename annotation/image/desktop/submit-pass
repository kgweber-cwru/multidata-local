#!/usr/bin/env bash
# Check and submit a finished pass.
#
# Refuses on empty segments, warns about the excerpt window. What and why is in
# submit_checks.py; this script is the wrapper that asks, uploads, and says
# clearly that pass 1 is now frozen.
set -euo pipefail

META=http://metadata.google.internal/computeMetadata/v1/instance/attributes
meta() { curl -fsSL -H "Metadata-Flavor: Google" "$META/$1"; }
BUCKET="$(meta bucket)"
ANNOTATOR="$(meta annotator)"

say() { zenity --info     --width 460 --text "$1" 2>/dev/null || echo "$1"; }
err() { zenity --error    --width 460 --text "$1" 2>/dev/null || echo "$1" >&2; }
ask() { zenity --question --width 460 --text "$1" 2>/dev/null; }

shopt -s nullglob
CASES=(/srv/multidata/case/*/)
shopt -u nullglob

if [[ ${#CASES[@]} -eq 0 ]]; then
  say "No case on this machine."
  exit 0
fi

if [[ ${#CASES[@]} -eq 1 ]]; then
  CASE="$(basename "${CASES[0]}")"
else
  NAMES=()
  for d in "${CASES[@]}"; do NAMES+=("$(basename "$d")"); done
  CASE="$(zenity --list --title "Submit which case?" --width 320 --height 260 \
    --column Case "${NAMES[@]}" 2>/dev/null)" || exit 0
fi

DIR="/srv/multidata/case/$CASE"
EAF=""
for f in "$DIR"/*.eaf; do EAF="$f"; break; done
if [[ -z "$EAF" ]]; then
  err "No .eaf found for case $CASE."
  exit 1
fi

# The excerpt window, if this case has one, comes from the kit.
SPAN=()
read -r START END <<<"$(python3 /usr/local/bin/read_span.py "$DIR/kit.json")"
if [[ -n "${START:-}" ]]; then
  SPAN=(--span-start "$START" --span-end "$END")
fi

if OUTPUT="$(python3 /usr/local/bin/submit_checks.py "$EAF" "${SPAN[@]}" 2>&1)"; then
  :
else
  err "Not submitted.

$OUTPUT"
  exit 1
fi

ask "$OUTPUT

Submit case $CASE as your finished pass 1?

Once submitted, pass 1 is frozen. If you think of something afterwards, report
it rather than reopening the file -- it gets handled in adjudication, where the
change is recorded." || exit 0

gcloud storage rsync --recursive "$DIR" "$BUCKET/work/$CASE/$ANNOTATOR"
python3 /usr/local/bin/write_submission.py "$DIR" "$ANNOTATOR" "$CASE"
gcloud storage cp "$DIR/submission.json" "$BUCKET/work/$CASE/$ANNOTATOR/"
touch "$DIR/.submitted"

say "Case $CASE submitted. Pass 1 is now frozen.

Let the project lead know you are done."
