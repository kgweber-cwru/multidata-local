[Unit]
Description=Annotation desktop (VNC display %i)
After=network.target

[Service]
Type=simple
User=annotator
WorkingDirectory=/home/annotator
Environment=HOME=/home/annotator

# Binds 127.0.0.1 only, deliberately. There IS a VNC password (install.sh
# writes ~/.vnc/passwd), so TigerVNC would be willing to listen on the network
# -- we decline. The desktop is reached by SSH port forwarding to this loopback
# address, so no VNC port is open to anything, anywhere.
#
# So the desktop is reached by SSH port forwarding, not by pointing IAP at
# 5901. annotation/gcp/connect.sh tunnels IAP to port 22 -- the path every other
# script here already uses -- and forwards a local port to this loopback
# address. That is the better arrangement anyway:
#
#   * The firewall only needs port 22 open to IAP's range, never 5901.
#   * The real authentication is Google IAM, against a named person.
#
# The VNC password exists for the client's sake, not the threat model's: macOS
# Screen Sharing cannot connect to a server offering no authentication -- it
# prompts and then hangs -- and giving it a password means Mac annotators need
# no viewer installed at all. It is a weak secret by protocol design (8
# characters, and VNC's challenge-response is old), which is fine here: it
# travels inside the SSH tunnel and is the second of two locks, not the first.
#
# Runs ~/.vnc/xstartup, which install.sh writes -- TigerVNC's own default path.
ExecStart=@VNCSERVER@ :%i -fg \
          -localhost yes \
          -geometry 1600x1000 -depth 24
ExecStop=@VNCSERVER@ -kill :%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
