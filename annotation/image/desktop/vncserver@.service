[Unit]
Description=Annotation desktop (VNC display %i)
After=network.target

[Service]
Type=simple
User=annotator
WorkingDirectory=/home/annotator
Environment=HOME=/home/annotator

# -localhost yes   listen only on the loopback interface, so the only way in is
#                  the IAP tunnel that terminates on this machine.
# -SecurityTypes None
#                  no VNC password. Deliberate, not an oversight: the tunnel is
#                  already authenticated by Google IAM against a named person
#                  (annotation/gcp/connect.sh), and nothing can reach this port
#                  without getting through that first. A second shared password
#                  would add a credential to distribute and rotate without
#                  adding a boundary. TigerVNC will not start without one of
#                  these two being set, so it has to be said explicitly.
# Runs ~/.vnc/xstartup, which install.sh writes -- TigerVNC's own default path.
ExecStart=@VNCSERVER@ :%i -fg \
          -localhost yes -SecurityTypes None \
          -geometry 1600x1000 -depth 24
ExecStop=@VNCSERVER@ -kill :%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
