[Unit]
Description=Annotation desktop (VNC display %i)
After=network.target

[Service]
Type=simple
User=annotator
WorkingDirectory=/home/annotator
Environment=HOME=/home/annotator

# Binds 127.0.0.1 only, and that is not a choice we get to make: TigerVNC
# refuses to expose a server with -SecurityTypes None to the network, and binds
# loopback whatever you pass it. (Proven the hard way -- removing -localhost
# from this line changed nothing; it still came up on 127.0.0.1.) The two
# settings are coupled: no password means loopback, full stop.
#
# So the desktop is reached by SSH port forwarding, not by pointing IAP at
# 5901. annotation/gcp/connect.sh tunnels IAP to port 22 -- the path every other
# script here already uses -- and forwards a local port to this loopback
# address. That is the better arrangement anyway:
#
#   * No VNC password to create, distribute or rotate. The desktop is
#     unreachable except from inside an authenticated SSH session.
#   * The firewall only needs port 22 open to IAP's range, never 5901.
#   * One authentication, by Google IAM, against a named person.
#
# -localhost yes is therefore stated explicitly, as documentation of an intended
# property rather than an attempt to change TigerVNC's behaviour.
#
# Runs ~/.vnc/xstartup, which install.sh writes -- TigerVNC's own default path.
ExecStart=@VNCSERVER@ :%i -fg \
          -localhost yes -SecurityTypes None \
          -geometry 1600x1000 -depth 24
ExecStop=@VNCSERVER@ -kill :%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
